# Production Environment Template
# Copy this file to .env and replace all placeholder values with real production secrets.

DJANGO_SETTINGS_MODULE=config.settings_production
SECRET_KEY=generate-a-strong-random-secret-key-at-least-50-characters-long
DEBUG=False

# Host & Origin Configuration
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# PostgreSQL Database Configuration
DB_ENGINE=postgresql
DB_NAME=student_management_db
DB_USER=student_admin
DB_PASSWORD=replace-with-ultra-secure-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Field-Level Encryption Key (AES-256 / Fernet key for bank accounts, Aadhaar, sensitive data)
DATA_ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-encryption-key

# Security & SSL
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Logging & Monitoring
LOG_LEVEL=INFO
